{
    "name": "aldea-universitaria/gestion-bienes",
    "description": "Sistema de gestión de bienes para Aldea Universitaria",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs --standard=PSR12 app/ public/index.php",
        "lint-fix": "phpcbf --standard=PSR12 app/ public/index.php"
    },
    "config": {
        "optimize-autoloader": true
    }
}